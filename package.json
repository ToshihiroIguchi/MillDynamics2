{
  "name": "mill-dynamics-2",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "asbuild:debug": "asc assembly/index.ts --target debug",
    "asbuild": "asc assembly/index.ts --target release",
    "dev": "npm run asbuild && vite",
    "build": "npm run asbuild && tsc --noEmit && vite build && node -e \"const fs=require('fs'); fs.copyFileSync('assembly/build/mill.wasm', 'dist/mill.wasm');\"",
    "preview": "vite preview --port 4173",
    "test": "npm run asbuild:debug && vitest run",
    "smoke": "node scripts/smoke.mjs",
    "experiments": "npx tsx scripts/run_experiments.ts",
    "experiments:rve": "npx tsx scripts/run_rve_e6.ts",
    "experiments:report": "node scripts/report_experiments.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.2.0",
    "assemblyscript": "^0.27.36",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
